# ------------------------------------------------------------
# AI補助（任意）
#
# 未設定でもアプリは動く。その場合、本文は外部へ送られず、
# 端末の中だけで動く簡易版の候補抽出と、名前から作る図案が使われる。
#
# 設定すると、資料の候補抽出と図案づくりがモデル経由になる。
# 本文生成・表紙生成は、鍵があっても行わない（指示文が存在しない）。
#
# 鍵は platform.openai.com の Settings → API keys で作る。
# 先に Billing でクレジットカードの登録が要る（無料枠は無い）。
# ------------------------------------------------------------
OPENAI_API_KEY=

# 候補抽出。小さい模型で足りる。本文3000字ほどで1回1円未満
OPENAI_TEXT_MODEL=gpt-4o-mini

# 資料の図案。mini のほうが1枚あたり安い
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# ------------------------------------------------------------
# Supabase（移行後に使う）
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
